# انسخ هذا الملف إلى .env واملأ القيم الخاصة بك
# لا تقم أبداً بنشر ملف .env الحقيقي أو committingه إلى Git

TELEGRAM_BOT_TOKEN=PASTE_YOUR_OWN_BOT_TOKEN_FROM_BOTFATHER
ADMIN_ID=PASTE_YOUR_OWN_TELEGRAM_USER_ID
BOT_LOG_FILE=/data/data/com.termux/files/home/bot-logs/mybot.log
BATTERY_CHECK_INTERVAL=1800
RECORD_MAX_SECONDS=600
RATE_LIMIT_WINDOW=3

# المفتاح السري لبوابة استقبال SMS (محلية فقط على 127.0.0.1)
# ولّد قيمة عشوائية خاصة بك، مثلاً عبر:  python -c "import secrets; print(secrets.token_hex(16))"
# إن تركته فارغاً سيُولَّد مفتاح عشوائي عند كل تشغيل ويُطبع في سجل البوت.
SMS_SECRET=CHANGE_ME_random_hex_unique_per_installation
SMS_GATEWAY_PORT=8765

# حد الطلبات لبوابة SMS (منع الإغراق المحلي)
SMS_RATE_MAX=10
SMS_RATE_WINDOW=60
